+                started.time_since_epoch()).count()
+            << " source_submit_us=" << micros(submitted)
+            << " source_ready_us=" << (sourceReady ? micros(*sourceReady) : -1)
+            << " output_ready_us=" << (outputReady ? micros(*outputReady) : -1)
+            << " admitted=" << (usable && plan.admittedGeneratedFrameCount == 1)
+            << " render_ready_us=" << (renderReady ? micros(*renderReady) : -1)
+            << " same_queue=" << (vk.queue() == invocation.queue)
+            << " deadline_us=" << micros(deadline)
+            << " worker_on_time=" << ready
+            << " worker_rejected=" << (ready && !usable)
+            << " acquire_us=" << std::chrono::duration_cast<std::chrono::microseconds>(acquisition).count()
+            << '\n';
+        std::clog << out.str();
+    }
+    if (usable && plan.admittedGeneratedFrameCount == 1) {
+        if (presentDiagnosticsEnabled()) {
+            std::clog << "MAKO Renderer: anvil-deadline action=completed"
+                      << " frame=" << this->frameState.realFrameIndex
+                      << " output=" << outputValue << '\n';
+        }
+        this->frameState.backendFrameIndex++;
+        this->frameState.backendSourceCadence = invocation.cadenceStarted;
+        // The existing Gamescope output clock must see the generated image
+        // and its original as a single two-output source batch.
+        this->bridgeOutputBatchSize = plan.admittedGeneratedFrameCount + 1;
+        return this->presentGeneratedFrames(invocation, plan, false);
+    }
+
+    // Only the renderer's own source-copy timeline enters the fallback queue.
+    // Keep the missing output's value reserved until it is actually complete.
+    if (!ready)
+        recovery.anvilOutputPending = outputValue;
+    this->frameState.backendTimelineIndex++;
+    this->diagnosticsState.fixedSkippedFrames++;
+    if (presentDiagnosticsEnabled()) {
+        std::clog << "MAKO Renderer: anvil-deadline action=real-only"
+                  << " frame=" << this->frameState.realFrameIndex
+                  << " reason=" << (!ready ? "worker-deadline" : !usable ? "motion-rejected" : "wsi-busy")
+                  << " output=" << outputValue << " elapsed_us="
+                  << std::chrono::duration_cast<std::chrono::microseconds>(
+                       DiagnosticsClock::now() - started).count() << '\n';
+    }
+    return this->presentHistoryOnly(invocation, plan, sourceValue);
+}
