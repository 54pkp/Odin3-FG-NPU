new file mode 100644
index 0000000000000000000000000000000000000000..f266394d6b6820678334b075d0eb307c7ba273cf
--- /dev/null
+++ b/engine/mako-common/include/mako-common/configuration/anvil_deadline.hpp
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+#include <vulkan/vulkan_core.h>
+
+namespace mako {
+    inline constexpr auto anvilPresentBudget = std::chrono::milliseconds(7);
+    inline constexpr auto anvilReadyWindowCeiling = 2 * anvilPresentBudget;
+    inline constexpr auto anvilScheduleReplyBudget = std::chrono::milliseconds(2);
+    inline constexpr VkImageUsageFlags anvilSourceImageUsage =
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+        VK_IMAGE_USAGE_SAMPLED_BIT;
+    inline constexpr VkImageUsageFlags anvilOutputImageUsage =
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+
+    inline bool anvilDeadlineEnabled() noexcept {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MAKO_ANVIL_DEADLINE");
+            return value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }
+
+    inline bool anvilRenderBoundaryEnabled() noexcept {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MAKO_ANVIL_RENDER_BOUNDARY");
+            return anvilDeadlineEnabled() && value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }
+
+    inline bool anvilReadyWindowEnabled() noexcept {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MAKO_ANVIL_READY_WINDOW");
+            return anvilRenderBoundaryEnabled() && value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }
+
+    inline bool anvilAsyncScheduleEnabled() noexcept {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MAKO_ANVIL_ASYNC_SCHEDULE");
+            return anvilDeadlineEnabled() && value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }
+
+    inline bool anvilMotionEnabled() noexcept {
+        static const bool enabled = [] {
+            const char* value = std::getenv("MAKO_ANVIL_MOTION");
+            return anvilAsyncScheduleEnabled() && value && std::string_view(value) == "1";
+        }();
+        return enabled;
+    }
+}
